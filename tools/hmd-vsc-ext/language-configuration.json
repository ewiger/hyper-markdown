{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["[[", "]]"],
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[[", "close": "]]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[[", "]]"],
    ["(", ")"],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"]
  ],
  "wordPattern": "([A-Za-z0-9_\\-/]+)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*([*+-]|\\d+\\.)\\s+.*$",
      "action": { "indent": "none", "appendText": "" }
    }
  ]
}
