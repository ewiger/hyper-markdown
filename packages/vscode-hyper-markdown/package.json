{
  "name": "vscode-hyper-markdown",
  "displayName": "Hyper-Markdown",
  "description": "Live preview, embeds, backlinks, and diagnostics for hyper-markdown (.hmd) knowledge bases.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "hyper-markdown",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ewiger/hyper-markdown.git",
    "directory": "packages/vscode-hyper-markdown"
  },
  "bugs": {
    "url": "https://github.com/ewiger/hyper-markdown/issues"
  },
  "homepage": "https://github.com/ewiger/hyper-markdown",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Notebooks"
  ],
  "keywords": [
    "hyper-markdown",
    "hmd",
    "wiki",
    "wikilinks",
    "knowledge base"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Indexing and preview are read-only and run in untrusted workspaces. Creating a missing card requires trust."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "hmd",
        "aliases": [
          "Hyper-Markdown",
          "hmd"
        ],
        "extensions": [
          ".hmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hmd",
        "scopeName": "source.hmd",
        "path": "./syntaxes/hmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hyperMarkdown",
          "title": "Hyper-Markdown",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hyperMarkdown": [
        {
          "type": "webview",
          "id": "hyperMarkdown.preview",
          "name": "Preview",
          "contextualTitle": "Hyper-Markdown"
        }
      ]
    },
    "commands": [
      {
        "command": "hyperMarkdown.openPreview",
        "title": "Open Preview",
        "category": "Hyper-Markdown"
      },
      {
        "command": "hyperMarkdown.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Hyper-Markdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "hyperMarkdown.togglePin",
        "title": "Pin Preview to This Card",
        "category": "Hyper-Markdown",
        "icon": "$(pin)"
      },
      {
        "command": "hyperMarkdown.createCardFromLink",
        "title": "Create Missing Card",
        "category": "Hyper-Markdown"
      },
      {
        "command": "hyperMarkdown.refreshIndex",
        "title": "Rebuild Index",
        "category": "Hyper-Markdown",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hyperMarkdown.openPreviewToSide",
          "when": "editorLangId == hmd",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "hyperMarkdown.createCardFromLink",
          "when": "editorLangId == hmd"
        }
      ]
    },
    "configuration": {
      "title": "Hyper-Markdown",
      "properties": {
        "hyperMarkdown.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Namespace root, relative to the workspace folder. Empty means discover it from `.hmd/config.toml`, falling back to `doc/wiki`."
        },
        "hyperMarkdown.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep the preview and the editor scrolled to the same source line."
        },
        "hyperMarkdown.preview.embeds": {
          "type": "string",
          "enum": [
            "expanded",
            "collapsed"
          ],
          "default": "expanded",
          "description": "Whether embed cards start expanded or collapsed."
        },
        "hyperMarkdown.diagnostics.scope": {
          "type": "string",
          "enum": [
            "open",
            "workspace"
          ],
          "default": "workspace",
          "markdownDescription": "Publish diagnostics for open documents only, or for every card in the index. A red link in a card nobody has opened is still a work item."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@hyper-markdown/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
